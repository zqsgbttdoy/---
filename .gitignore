# ============================================================
# 监理现场管理系统 - Git 忽略规则
# 目的：只上传源码 / 配置 / 文档，排除本地缓存、构建产物、
#       依赖包、运行期数据与日志，避免仓库膨胀与敏感信息泄露。
# ============================================================

# ---------- 本地 Maven 依赖缓存（约 90MB，属于下载缓存，不入库） ----------
.m2-cache/

# ---------- 构建产物 ----------
# Maven 打包输出（jar/war/classes），可用 mvn package 重新生成
**/target/
# 前端/发布打包输出目录
dist/
# 一键打包生成的发布产物
*.jar
*.war
*.zip

# ---------- 随项目附带的 Maven 发行版 / 本地仓库（可重新下载） ----------
**/apache-maven-*/
**/.mvn/maven/

# ---------- Node 依赖（可用 npm install 还原） ----------
**/node_modules/

# ---------- 日志 ----------
logs/
*.log

# ---------- 运行期用户上传文件（非源码，测试/生产数据盘内容） ----------
uploads/
**/uploads/

# ---------- 本地密钥 / 环境变量（只保留 *.example 模板，真实值不入库） ----------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# ---------- 操作系统 / 编辑器临时文件 ----------
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
