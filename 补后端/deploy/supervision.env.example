# ==============================================================================
# 监理现场管理系统 - 生产环境变量模板
#
# 使用方法：
#   1. 复制本文件为 supervision.env：
#        cp supervision.env.example /opt/supervision/backend/supervision.env
#   2. 填写下方所有【必填】变量的真实值（不要保留占位符）
#   3. 收紧文件权限，防止密钥泄露：
#        chmod 600 /opt/supervision/backend/supervision.env
#        chown supervision:supervision /opt/supervision/backend/supervision.env
#
# 本文件由 systemd 单元 supervision.service 通过 EnvironmentFile= 加载。
# 注意：systemd EnvironmentFile 格式为 KEY=VALUE，等号两侧不要有空格，
#       值中若包含特殊字符建议用双引号包裹。
# ==============================================================================

# ------------------------------------------------------------------------------
# 【必填 1/8】激活生产配置 profile（application-prod.yml），固定为 prod
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 【必填 2/8】数据库用户名：使用专用账号（由 init-database.sh 创建），禁止使用 root
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_USERNAME=supervision_app

# ------------------------------------------------------------------------------
# 【必填 3/8】数据库密码：与 init-database.sh 中创建专用账号时输入的密码一致，
# 禁止弱密码（root/123456），且必须长度 ≥8 位、同时包含字母与数字，否则会被应用启动校验拦截
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_PASSWORD=请替换为数据库专用账号密码

# ------------------------------------------------------------------------------
# 【必填 4/8】JWT 签名密钥：长度必须 ≥32 字符，且不得等于开发默认密钥。
# 推荐使用以下命令生成随机密钥（64 字符 base64）：
#     openssl rand -base64 48
# ------------------------------------------------------------------------------
APP_JWT_SECRET=请替换为openssl_rand_-base64_48生成的随机密钥

# ------------------------------------------------------------------------------
# 【必填 5/8】允许跨域来源：逗号分隔的明确域名列表（含协议），禁止使用 *
# 示例：https://your-domain.com,https://www.your-domain.com
# ------------------------------------------------------------------------------
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com

# ------------------------------------------------------------------------------
# 【必填 6/8】管理员重置用户密码时下发的默认密码：禁止使用 123456，
# 必须长度 ≥8 位、同时包含字母与数字（否则启动被拦截），建议告知管理员妥善保管
# ------------------------------------------------------------------------------
APP_DEFAULT_RESET_PASSWORD=请替换为重置默认密码

# ------------------------------------------------------------------------------
# 【必填 7/8】上传文件物理根目录：生产建议使用独立数据盘绝对路径
# （目录由 aliyun-init.sh 创建并授权给 supervision 用户）
# ------------------------------------------------------------------------------
APP_UPLOAD_DIR=/opt/supervision/uploads

# 【必填 8/8】附件短时链接独立签名密钥：≥32 字符，不得复用 APP_JWT_SECRET。
# 单独执行 openssl rand -base64 48 生成；多实例使用同一密钥与共享上传目录。
APP_UPLOAD_SIGNING_SECRET=请替换为独立生成的附件签名随机密钥

# ------------------------------------------------------------------------------
# 【可选】数据库连接地址：仅当数据库不在本机 3306 端口或库名不同时才需要配置。
# 默认值（见 application-prod.yml）：
#   jdbc:mysql://localhost:3306/supervision_db?useUnicode=true&characterEncoding=utf-8&useSSL=true&serverTimezone=Asia/Shanghai
# ------------------------------------------------------------------------------
# SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/supervision_db?useUnicode=true&characterEncoding=utf-8&useSSL=true&serverTimezone=Asia/Shanghai"

# ------------------------------------------------------------------------------
# 【可选】允许上传的扩展名白名单（逗号分隔），默认见 application-prod.yml，
# 可按业务需要收紧，例如只允许图片与 PDF：
# ------------------------------------------------------------------------------
# APP_UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf
