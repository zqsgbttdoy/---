<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置（logback-spring.xml）
  - CONSOLE：控制台输出
  - FILE：滚动文件（logs/app.log），按天滚动 + 单文件 50MB，保留 30 天，总量上限 2GB
  - ASYNC_FILE：文件输出的异步包装，降低 I/O 对请求线程的影响
  - 日志路径可通过启动参数 -DLOG_PATH 或环境变量 LOG_PATH 覆盖，默认 logs
  - 注意：application.yml 中的 logging.level 配置优先级更高，会覆盖此处的 level 设置
-->
<configuration>

    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] [%thread] %logger{36} [%X{traceId}] - %msg%n"/>

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 滚动文件输出：按天滚动 + 单文件 50MB，保留 30 天，总量上限 2GB -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件输出异步包装：队列 512，队列满时丢弃日志而不阻塞业务线程 -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <neverBlock>true</neverBlock>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- 非生产环境：控制台 + 文件，应用包 DEBUG -->
    <springProfile name="!prod">
        <logger name="com.supervision" level="DEBUG"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

    <!-- 生产环境：文件为主，控制台仅 WARN 及以上 -->
    <springProfile name="prod">
        <appender name="CONSOLE_WARN" class="ch.qos.logback.core.ConsoleAppender">
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>WARN</level>
            </filter>
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <logger name="com.supervision" level="INFO"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE_WARN"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

</configuration>
