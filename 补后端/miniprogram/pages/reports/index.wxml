<view class="container">
  <view class="hero"><view class="title">报表统计</view><view>只读汇总 · 详细分析请使用 PC 端</view></view>
  <view class="card">
    <view class="label">记录类型</view>
    <view class="grid"><button wx:for="{{types}}" wx:key="kind" class="small" data-kind="{{item.kind}}" bindtap="selectKind">{{item.title}}{{kind === item.kind ? ' ✓' : ''}}</button></view>
    <view class="label" style="margin-top:16rpx">当前项目</view>
    <picker range="{{projects}}" range-key="name" value="{{projectIndex}}" bindchange="selectProject"><view class="picker">{{projects[projectIndex].name || '暂无获授权项目'}}</view></picker>
    <view class="row" style="margin-top:16rpx">
      <picker mode="date" value="{{dateFrom}}" bindchange="pickFrom"><view class="picker">{{dateFrom}}</view></picker>
      <view class="muted">至</view>
      <picker mode="date" value="{{dateTo}}" bindchange="pickTo"><view class="picker">{{dateTo}}</view></picker>
    </view>
    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="reload">查询{{kindTitle}}</button>
    <view class="error" wx:if="{{error}}">{{error}}</view>
  </view>
  <view class="card" wx:if="{{summary}}">
    <view class="label">区间汇总（{{dateFrom}} 至 {{dateTo}}）</view>
    <view class="muted">共 {{summary.total}} 条记录</view>
    <view class="muted" wx:if="{{!summary.total}}">该区间内没有可见记录，请确认项目与日期范围。</view>
    <view class="row" wx:for="{{statusList}}" wx:key="label"><view>{{item.label}}</view><view>{{item.count}} 条</view></view>
  </view>
  <view class="card" wx:if="{{summary && summary.total}}">
    <view class="label">按人员明细</view>
    <view wx:for="{{rows}}" wx:key="authorId" class="card">
      <view class="row"><view class="label">{{item.name}}</view><view class="badge">共 {{item.total}} 条</view></view>
      <view class="muted">{{item.statusText}}</view>
      <view class="muted">覆盖工作日 {{item.workDays}} 天（同一日期多条记录只计一天）</view>
    </view>
  </view>
</view>
